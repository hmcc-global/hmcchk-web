<% /* Note: This is injected into `views/layouts/layout-email.ejs` */ %>
<p style="margin-bottom: 25px; color: #222222">
  Dear <%= typeof fullName !== 'undefined' && fullName ? fullName : 'Supporter' %>,
</p>
<p style="margin-bottom: 15px; color: #222222">
  Thank you for your generosity in supporting members of our church to join
  <b>Here To Witness: The Retreat</b>, from the evening of
  <b>Friday, 29 January 2027</b> to the night of
  <b>Sunday, 31 January 2027</b> at
  <b>Chinese Y.M.C.A. Wu Kai Sha Youth Village</b>.
</p>
<p style="margin-bottom: 25px; color: #222222">
  Currently, your donation is
  <b style="color: #ff0000; text-decoration: underline">INCOMPLETE</b>
  until we have received the payment, therefore please read the instructions
  below carefully so we can match your gift to you:
</p>

<h3
  style="
    font-size: 14pt;
    color: #434343;
    margin: 20px 0 6px 0;
    text-transform: uppercase;
  "
>
  Donation Instructions
</h3>
<p style="margin-bottom: 15px; color: #222222">
  When donating, always add a <b>remark or memo in this format</b> so we can
  match your donation to you:
</p>
<p style="margin-bottom: 15px; color: #222222">
  <b>RT: [Full Name] DONATION</b>
</p>
<ul style="margin: 0 0 15px 0; padding-left: 20px; color: #222222">
  <li>One person: <b>RT: Bob Chan DONATION</b></li>
  <li>
    <i>
      If you forget to add a remark or memo, email
      <a
        href="mailto:retreats@hongkong.hmcc.net"
        style="color: #1155cc; text-decoration: underline"
        >retreats@hongkong.hmcc.net</a
      >
      with your name and the amount you gave.
    </i>
  </li>
</ul>

<h3
  style="
    font-size: 14pt;
    color: #434343;
    margin: 20px 0 6px 0;
    text-transform: uppercase;
  "
>
  Payment Methods
</h3>
<ul style="margin: 0 0 15px 0; padding-left: 20px; color: #222222">
  <li>
    <b>Faster Payment System (FPS)</b>
    <ul style="margin: 6px 0; padding-left: 20px">
      <li>
        Open your mobile banking FPS interface and scan the QR code or input the
        FPS identifier
      </li>
      <li>
        Name: <b>HARVEST MISSION COMMUNITY CHURCH</b>
        <ul style="margin: 6px 0; padding-left: 20px">
          <li>FPS ID: <b>167534304</b></li>
        </ul>
      </li>
    </ul>
    <img
      style="
        display: block;
        height: 100px;
        width: auto;
        margin: 10px 0 10px 20px;
      "
      src="https://hk.hmccglobal.org/images/giving/FPSQR.png"
      alt="FPS QR code"
    />
  </li>
  <li>
    <b>Direct Bank Transfer</b>
    <ul style="margin: 6px 0; padding-left: 20px">
      <li>
        Bank Name:
        <b>China Construction Bank (Asia) Corporation Limited</b>
      </li>
      <li>Bank Code: <b>009</b></li>
      <li>Branch Code: <b>845</b></li>
      <li>
        Account Name:
        <b>Harvest Mission Community Church (Hong Kong) Limited</b>
      </li>
      <li>Account Number: <b>013012090</b></li>
      <li>
        If the account name is too long and exceeds the number of permitted
        characters, you may shorten it as "Harvest Community Church HK"
      </li>
    </ul>
  </li>
  <li>
    <b>Cash</b>
    <ul style="margin: 6px 0; padding-left: 20px">
      <li>
        For cash donations, please reach out to your LG leader to assist you in
        transferring the funds to us.
      </li>
      <li>
        Please indicate “Faster Payment System (FPS)” under the “Payment method”
        field in the donation form.
      </li>
    </ul>
  </li>
</ul>

<p style="margin-bottom: 15px; color: #222222">
  <b>
    Please email a copy of your transfer receipt along with your Full Name
    within 2 weeks to
    <a
      href="mailto:stewardship@hongkong.hmcc.net"
      style="color: #1155cc; text-decoration: underline"
      >stewardship@hongkong.hmcc.net</a
    >
  </b>
</p>
<p style="margin-bottom: 25px; color: #222222">
  If you have any questions or enquiries, please contact us at
  <a
    href="mailto:retreats@hongkong.hmcc.net"
    style="color: #1155cc; text-decoration: underline"
    >retreats@hongkong.hmcc.net</a
  >.
</p>

<p style="margin-bottom: 5px; color: #222222">God Bless,</p>
<p style="margin-top: 0px; color: #222222">HMCC of HK</p>
